#!/usr/bin/env bash

set -euo pipefail

OUTPUT="${1:-autoytdlpmanager}"

echo "Building with CGO enabled..."
CGO_ENABLED=1
go build -ldflags="-s -w" -gcflags="-N -l" -o "$OUTPUT"

echo "Build successful: $OUTPUT"

echo
echo "CGO_ENABLED = $(go env CGO_ENABLED)"
echo

if command -v ldd >/dev/null 2>&1; then
    echo "Linked libraries:"
    ldd "$OUTPUT" || true
fi